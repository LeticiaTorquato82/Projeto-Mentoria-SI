{
  "name": "mentoria-julio-de-lima",
  "version": "1.0.0",
  "description": "Projeto de Portifólio pessoal Mentoria 2.0 em teste de Software",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "postman": "newman run postman/TaskManagement.postman_collection.json -e postman/TaskManagement.postman_environment.json",
    "postman:html": "newman run postman/TaskManagement.postman_collection.json -e postman/TaskManagement.postman_environment.json -r htmlextra --reporter-htmlextra-export ./reports/newman/report.html",
    "load:test": "k6 run --vus 5 --duration 15s --out json=reports/k6/result.json load/test.js",
    "k6:report": "echo 'Use o comando do k6 para gerar JSON e inspecione o arquivo reports/k6/result.json'",
    "audit:fix": "npm audit fix --force"
  },
  "overrides": {
    "handlebars": "^4.7.8",
    "lodash": "^4.17.21",
    "qs": "^6.14.1",
    "semver": "^7.5.4",
    "tough-cookie": "^4.1.3",
    "uuid": "^11.1.1",
    "word-wrap": "^1.2.4",
    "underscore": "^1.13.8",
    "flatted": "^3.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Letytorquato82/Mentoria-Julio-de-Lima.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ajv": "^8.0.0",
    "ajv-formats": "^2.1.0",
    "express": "^4.18.0",
    "graphql": "^15.8.0",
    "graphql-http": "^1.23.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "jest-html-reporter": "^3.4.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.0.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/load/"
    ],
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "Test Report",
          "outputPath": "reports/jest/report.html",
          "includeFailureMsg": true,
          "includeConsoleLog": true
        }
      ]
    ]
  },
  "bugs": {
    "url": "https://github.com/Letytorquato82/Mentoria-Julio-de-Lima/issues"
  },
  "homepage": "https://github.com/Letytorquato82/Mentoria-Julio-de-Lima#readme"
}
